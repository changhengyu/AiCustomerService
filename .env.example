# ===== Tongyi (通义千问) =====
TONGYI_API_KEY=sk-your-dashscope-api-key
TONGI_BASE_URL=https://dashscope.aliyuncs.com
TONGYI_CHAT_MODEL=qwen-plus
TONGYI_EMBEDDING_MODEL=text-embedding-v3

# ===== 多 LLM 适配器 (v0.3.0+) =====
# 通过 AiProviders__Providers__0__Name 等配置（详见 appsettings.json AiProviders 节点）
# 租户可使用相同 Key，只需在管理后台切换 Provider

# ===== JWT =====
JWT_SECRET=please-change-this-to-a-32-character-secret-string-please
JWT_ISSUER=AiCustomerService
JWT_AUDIENCE=AiCustomerService
JWT_EXPIRY_MINUTES=720
JWT_REFRESH_EXPIRY_DAYS=30

# ===== WeChat =====
WECHAT_OFFICIAL_TOKEN=your-wechat-token
WECHAT_AES_KEY=your-43-char-encoding-aes-key
WECHAT_APP_SECRET=your-wechat-app-secret
